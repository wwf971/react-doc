config.0.yaml
node_modules/
dist/
build/
.next/
next-env.d.ts
*.tsbuildinfo
*.pyc
__pycache__/
fyi*
*.zip
*.rar
package-lock.json
third_party/shadcn/

ai-dev*
# backups and temporary files of the asset store (doc_page_impl_asset.md);
# the folders themselves are content and are tracked. example_doc/.doc-page/asset has
# its own .gitignore, which keeps out everything not listed in it.
example_doc/.doc-page/asset-archive/**/*.bak
example_doc/.doc-page/asset-archive/**/*.tmp
example_doc/.doc-page/asset.yaml.bak
example_doc/.doc-page/asset.yaml.tmp
# backups the edit api keeps beside a configuration yaml file it rewrote
# (doc_page_impl_edit.md): doc page config values, side-panel labels
main/config*.yaml.bak
/.doc-workspace/*.yaml.bak
**/.doc-page/*.yaml.bak
# a virtual root of managed documents (main/doc_page_impl_doc_managed.md): the backup of its
# root.yaml, a file being written (its deleted documents are hidden backups, ignored below)
**/.doc-page/doc-managed/*/*.bak
**/.doc-page/doc-managed/*/*.tmp


# the state the service runtime kernel keeps beside a backend config file
update-*
# (doc_page_impl_service.md#the-service-runtime-kernel)
**/.doc-page/service-kernel.yaml
# the default backup folder of the local-backup infra service: the backups
# of a doc page's service instances (doc_page_impl_service.md#the-local-backup-infra-service)
**/.doc-page/service-backup/

# the built-in infra templates are not tracked yet, except local-backup
# (doc_page_impl_service.md#the-local-backup-infra-service): everything of
# service-template-infra/ is ignored but that template's folder (its build
# and installed dependencies stay ignored by the rules above)
**/service-template-infra/*
!**/service-template-infra/storage/
**/service-template-infra/storage/*
!**/service-template-infra/storage/w5f2xw18q2r--local-backup/

# playground documents: a document for trying things out belongs to one checkout, and
# its template is what is tracked (main/doc_page_impl_test.md)
**/*.playground.md
**/*.playground.mdx

# hidden backups of files deleted from the page, .{name}.{uuid}.deleted
# (doc_page_impl_source.md#creating-and-deleting-files)
**/.*.deleted


/temp*
# doc pages made by a script (package/aws-utils/script-demo/demo-create.mjs: generated/aws-demo); they
# hold the values of a deployment, which belong to whoever deployed it
/generated/
# what a storage point caches or is writing in a partition of a frontend object: a cache is never
# the truth (main/doc_page_impl_asset_storage.md#where-a-partition-lies)
**/.doc-page/object-frontend/*/item/*/.cache/
**/.doc-page/object-frontend/*/item/*/.tmp/

# what a reader of a zettelkasten writes (notes, progress): the partition "note" of its object, kept
# out of git with its item list (main/doc_page_impl_obj_frontend.md#partitions)
**/.doc-page/object-frontend/*/item/note/

# the layers a checkout or a machine sets in a config object of the package app-config: its partition
# "local", kept out of git with its item list (package/app-config/doc/README.md#partitions)
**/.doc-page/object-frontend/*/item/local/
