config.0.yaml
node_modules/
dist/
build/
.next/
next-env.d.ts
*.tsbuildinfo
*.pyc
__pycache__/
fyi*
*.zip
*.rar
package-lock.json
third_party/shadcn/

ai-dev*
# backups and temporary files of the asset store (doc_page_impl_asset.md);
# the folders themselves are content and are tracked. example_doc/asset has
# its own .gitignore, which keeps out everything not listed in it.
example_doc/asset-archive/**/*.bak
example_doc/asset-archive/**/*.tmp
example_doc/.doc-page/asset.yaml.bak
example_doc/.doc-page/asset.yaml.tmp
# backups the edit api keeps beside a configuration yaml file it rewrote
# (doc_page_impl_edit.md): doc page config values, side-panel labels
main/config*.yaml.bak
/workspace.yaml.bak
**/.doc-page/*.yaml.bak


# the state the service runtime kernel keeps beside a backend config file
update-*
# (doc_page_impl_service.md#the-service-runtime-kernel)
**/.doc-page/service-kernel.yaml
# the default backup folder of the local-backup infra service: the backups
# of a doc page's service instances (doc_page_impl_service.md#the-local-backup-infra-service)
**/.doc-page/service-backup/

# the built-in infra templates are not tracked yet, except local-backup
# (doc_page_impl_service.md#the-local-backup-infra-service): everything of
# service-template-infra/ is ignored but that template's folder (its build
# and installed dependencies stay ignored by the rules above)
**/service-template-infra/*
!**/service-template-infra/storage/
**/service-template-infra/storage/*
!**/service-template-infra/storage/w5f2xw18q2r--local-backup/

# hidden backups of files deleted from the page, .{name}.{uuid}.deleted
# (doc_page_impl_source.md#creating-and-deleting-files)
**/.*.deleted
